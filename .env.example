# Required — used to sign/verify JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Optional — defaults to a local SQLite file if unset.
# For Postgres: postgresql://user:password@host:port/dbname
# DATABASE_URL=

# Optional — used only by seed.py. Unset vars fall back to "changeme".
# SEED_ADMIN_PASSWORD=
# SEED_FRONTDESK_PASSWORD=
# SEED_HOUSEKEEPING_PASSWORD=
